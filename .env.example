# --- Required for real AI generation ---
OPENAI_API_KEY=

# --- Runtime ---
WORKSPACE_DIR=./workspace
MOCK_MODE=0
WEB_HOST=127.0.0.1
WEB_PORT=4173
UI_LANGUAGE=vi
CONTENT_LANGUAGE=vi

# --- Pipeline ---
# simple | whiteboard | cinematic-broll | draw-reveal
VIDEO_RENDERER=whiteboard
# openai | codex | mock
TEXT_PROVIDER=openai
# openai | codex | mock
IMAGE_PROVIDER=openai
VOICE_PROVIDER=openai
SCRIPT_TARGET_MINUTES=6
SCENE_TARGET_SEC=12
SCENE_MIN_SEC=6
SCENE_MAX_SEC=18
WORDS_PER_MINUTE=150
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Speak clearly, naturally, and conversationally for a YouTube explainer.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- ChatGPT subscription via local Codex CLI (used when TEXT_PROVIDER=codex and/or IMAGE_PROVIDER=codex) ---
CODEX_BIN=codex
# Leave blank to use the model selected by your ChatGPT/Codex account.
CODEX_MODEL=
CODEX_TIMEOUT_MS=300000

# --- Vivibe / LucyAI voice (used when VOICE_PROVIDER=vivibe) ---
VIVIBE_API_KEY=
VIVIBE_BASE_URL=https://api.lucylab.io/json-rpc
VIVIBE_VOICE_ID=
VIVIBE_SPEED=1
VIVIBE_POLL_INTERVAL_MS=2000
VIVIBE_TIMEOUT_MS=600000

# --- Optional B-roll search providers ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Whiteboard engine ---
WHITEBOARD_ENGINE_DIR=./vendor/srt-whiteboard-animation
WHITEBOARD_AUTO_INSTALL=1
# Optional: pin an already-prepared upstream Python interpreter. Leave empty for auto-detection via prepare_env.py.
WHITEBOARD_PYTHON=
PYTHON_BIN=python3

# --- Media tools ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
